TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE

# Owner identity: set BOTH values. Never commit your real .env file.
OWNER_USER_ID=123456789
OWNER_CHAT_ID=123456789

# Google Sheets integration (configure later)
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Video generation configuration
VIDEO_MODEL=veo-3.1-fast-generate-001
SHORT_VIDEO_SECONDS=8
SHORT_VIDEO_CREDITS=50
LONG_VIDEO_MINUTES=3
LONG_VIDEO_CREDITS=75
WELCOME_CREDITS=200
